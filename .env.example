# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# FastAPI Backend
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_API_PREFIX=/api/v1

# Backend mode: supabase_only | fastapi_preferred | fastapi_only
BACKEND_MODE=supabase_only

# Timeouts (milliseconds)
REQUEST_TIMEOUT_MS=15000
CONNECT_TIMEOUT_MS=10000

# Retry
MAX_RETRIES=2
RETRY_DELAY_MS=1000

# Feature flags
FF_COURSE_FINDER_FASTAPI=false
FF_JOB_FINDER_FASTAPI=false
FF_SEARCH_FASTAPI=false
FF_AI_COPILOT=false
FF_WEBSOCKET=false
